# Mantém quebra de linha LF no Mac e no Windows, mesmo com core.autocrlf ligado.
# Scripts .sh e o launcher da impeccable quebram no Git Bash se vierem com CRLF.
* text=auto eol=lf
.claude/skills/impeccable/scripts/impeccable text eol=lf
*.sh text eol=lf

# Arquivos do Windows precisam de CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.xlsx binary
*.docx binary
*.zip binary
